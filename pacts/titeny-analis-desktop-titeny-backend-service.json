    {
      "description": "baca prediksi harga",
      "providerStates": [
        {
          "name": "pasangan komoditas-pasar punya prediksi harga"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer token-uji-analis"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer .+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/harga",
        "query": {
          "komoditas_id": [
            "cmd_cabai_merah"
          ],
          "pasar_id": [
            "psr_jakarta_timur_01"
          ]
        }
      },
      "response": {
        "body": {
          "deret": [
            {
              "harga_prediksi": 42500,
              "horizon": "H+1",
              "kepercayaan": "sedang",
              "rentang_atas": 46000,
              "rentang_bawah": 39000,
              "tanggal": "2026-10-05"
            }
          ],
          "dihitung_pada": "2026-10-04T23:00:00Z",
          "komoditas_id": "cmd_cabai_merah",
          "model_version": "harga_v1.0.0",
          "pasar_id": "psr_jakarta_timur_01"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.deret": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.deret[*].harga_prediksi": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.deret[*].horizon": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.deret[*].kepercayaan": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.deret[*].rentang_atas": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.deret[*].rentang_bawah": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.deret[*].tanggal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              ]
            },
            "$.dihitung_pada": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.model_version": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
