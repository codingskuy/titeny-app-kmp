{
  "consumer": {
    "name": "titeny-analis-desktop"
  },
  "interactions": [
    {
      "description": "antrean validasi analis",
      "providerStates": [
        {
          "name": "ada event perlu_verifikasi yang belum diputuskan"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer token-uji-analis"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer .+"
                }
              ]
            }
          },
          "query": {
            "limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "\\d+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/analis/antrean",
        "query": {
          "limit": [
            "50"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "alasan_flag": "harga di luar rentang",
              "event_id": "evt_20261004_000123",
              "event_type": "harga_lapak",
              "flag": "perlu_verifikasi"
            }
          ],
          "next_cursor": null
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].alasan_flag": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].event_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^evt_\\d{8}_\\d{6}$"
                }
              ]
            },
            "$.data[*].event_type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "login analis (langkah 1)",
      "providerStates": [
        {
          "name": "akun analis ada dan kata sandi benar"
        }
      ],
      "request": {
        "body": {
          "password": "kata-sandi-uji",
          "username": "analis01"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.password": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.username": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/auth/login"
      },
      "response": {
        "body": {
          "otp_diperlukan": true,
          "sesi_id": "ses_abc123"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.sesi_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "keputusan dengan alasan di bawah 10 karakter",
      "providerStates": [
        {
          "name": "event evt_20261004_000123 berstatus perlu_verifikasi"
        }
      ],
      "request": {
        "body": {
          "aksi_id": "aks_20261004_009",
          "alasan": "pendek",
          "event_id": "evt_20261004_000123",
          "keputusan": "tolak"
        },
        "headers": {
          "Authorization": "Bearer token-uji-analis",
          "Content-Type": "application/json",
          "X-Idempotency-Key": "aks_20261004_009"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer .+"
                }
              ]
            },
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/analis/validasi"
      },
      "response": {
        "body": {
          "error": {
            "field": "alasan",
            "kode": "validasi_gagal",
            "pesan": "alasan harus 10-140 karakter."
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error.pesan": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 422
      }
    },
