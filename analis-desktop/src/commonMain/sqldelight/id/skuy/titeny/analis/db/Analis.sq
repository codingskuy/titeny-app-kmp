-- Cache lokal analis (SQLite): %LOCALAPPDATA%/Titeny/analis.db, maks 500 MB.
-- Server tetap sumber kebenaran; klien tidak pernah menulis langsung ke DB sumber.
-- Waktu = epoch milidetik.

CREATE TABLE antrean_cache (
    event_id TEXT NOT NULL PRIMARY KEY,
    event_type TEXT NOT NULL,
    flag TEXT NOT NULL,
    alasan_flag TEXT,
    diambil_pada INTEGER NOT NULL
);

CREATE INDEX antrean_cache_waktu ON antrean_cache(diambil_pada);

-- Antrean tulis idempoten: aksi_id = X-Idempotency-Key. 'payload' = badan JSON persis yang dikirim.
CREATE TABLE aksi_antre (
    aksi_id TEXT NOT NULL PRIMARY KEY,
    jenis TEXT NOT NULL,
    payload TEXT NOT NULL,
    dibuat_pada INTEGER NOT NULL,
    percobaan INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'menunggu',
    galat TEXT,
    diperbarui_pada INTEGER NOT NULL
);

CREATE INDEX aksi_antre_status ON aksi_antre(status, dibuat_pada);

-- Cache JSON generik (mis. prediksi harga per komoditas-pasar).
CREATE TABLE cache_json (
    kunci TEXT NOT NULL PRIMARY KEY,
    nilai TEXT NOT NULL,
    diambil_pada INTEGER NOT NULL
);

CREATE INDEX cache_json_waktu ON cache_json(diambil_pada);

CREATE TABLE meta (
    kunci TEXT NOT NULL PRIMARY KEY,
    nilai TEXT NOT NULL
);

-- Jejak ekspor: HANYA ditambah, tidak ada query ubah/hapus (audit tidak dapat dihapus analis dari aplikasi).
CREATE TABLE jejak_ekspor (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nama_berkas TEXT NOT NULL,
    jenis TEXT NOT NULL,
    format TEXT NOT NULL,
    jumlah_baris INTEGER NOT NULL,
    sha256 TEXT NOT NULL,
    dibuat_pada INTEGER NOT NULL,
    diserahkan_server INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX jejak_ekspor_waktu ON jejak_ekspor(dibuat_pada);

catatEkspor:
INSERT INTO jejak_ekspor(nama_berkas, jenis, format, jumlah_baris, sha256, dibuat_pada) VALUES (?, ?, ?, ?, ?, ?);

semuaEkspor:
SELECT * FROM jejak_ekspor ORDER BY id ASC;

hapusAntreanCache:
DELETE FROM antrean_cache;

simpanAntreanCache:
INSERT OR REPLACE INTO antrean_cache(event_id, event_type, flag, alasan_flag, diambil_pada) VALUES (?, ?, ?, ?, ?);

bacaAntreanCache:
SELECT * FROM antrean_cache ORDER BY diambil_pada ASC, event_id ASC;

stempelAntreanTerakhir:
SELECT MAX(diambil_pada) FROM antrean_cache;

simpanJson:
INSERT OR REPLACE INTO cache_json(kunci, nilai, diambil_pada) VALUES (?, ?, ?);

bacaJson:
SELECT * FROM cache_json WHERE kunci = ?;

antreAksi:
INSERT OR IGNORE INTO aksi_antre(aksi_id, jenis, payload, dibuat_pada, percobaan, status, galat, diperbarui_pada)
VALUES (?, ?, ?, ?, 0, 'menunggu', NULL, ?);

aksiMenunggu:
SELECT * FROM aksi_antre WHERE status = 'menunggu' ORDER BY dibuat_pada ASC, aksi_id ASC;

semuaAksi:
SELECT * FROM aksi_antre ORDER BY dibuat_pada ASC, aksi_id ASC;

hitungMenunggu:
SELECT COUNT(*) FROM aksi_antre WHERE status = 'menunggu';

tandaiTerkirim:
UPDATE aksi_antre SET status = 'terkirim', percobaan = percobaan + 1, galat = NULL, diperbarui_pada = ? WHERE aksi_id = ?;

tandaiGagal:
UPDATE aksi_antre SET status = 'gagal', percobaan = percobaan + 1, galat = ?, diperbarui_pada = ? WHERE aksi_id = ?;

tambahPercobaan:
UPDATE aksi_antre SET percobaan = percobaan + 1, galat = ?, diperbarui_pada = ? WHERE aksi_id = ?;

-- Pemangkasan FIFO: data tersinkron > 90 hari. Aksi 'menunggu' TIDAK PERNAH dihapus.
pangkasAntreanCache:
DELETE FROM antrean_cache WHERE diambil_pada < ?;

pangkasCacheJson:
DELETE FROM cache_json WHERE diambil_pada < ?;

pangkasAksiSelesai:
DELETE FROM aksi_antre WHERE status <> 'menunggu' AND diperbarui_pada < ?;

-- Pemangkasan karena batas ukuran: buang yang terlama dulu (FIFO).
hapusAntreanCacheTerlama:
DELETE FROM antrean_cache WHERE event_id IN (SELECT event_id FROM antrean_cache ORDER BY diambil_pada ASC LIMIT ?);

hapusCacheJsonTerlama:
DELETE FROM cache_json WHERE kunci IN (SELECT kunci FROM cache_json ORDER BY diambil_pada ASC LIMIT ?);

hapusAksiSelesaiTerlama:
DELETE FROM aksi_antre WHERE aksi_id IN (SELECT aksi_id FROM aksi_antre WHERE status <> 'menunggu' ORDER BY diperbarui_pada ASC LIMIT ?);

hitungBarisPemangkasan:
SELECT (SELECT COUNT(*) FROM antrean_cache) + (SELECT COUNT(*) FROM cache_json) + (SELECT COUNT(*) FROM aksi_antre WHERE status <> 'menunggu');

simpanMeta:
INSERT OR REPLACE INTO meta(kunci, nilai) VALUES (?, ?);

bacaMeta:
SELECT nilai FROM meta WHERE kunci = ?;
